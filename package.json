{"devDependencies":{"@playwright/test":"^1.56.1","@types/node":"^22.19.0","concurrently":"^9.2.1","eslint":"^9.39.0","eslint-config-next":"16.4.0","prettier":"3.9.6","prisma":"6.19.3","tsx":"^4.20.6","typescript":"^5.9.3","wrangler":"^4.160.1"},"name":"almost-formal","private":true,"scripts":{"admin:create":"tsx apps/api/src/create-admin.ts","admin:reset:d1":"npx tsx scripts/admin-reset-d1.ts","build":"npm run build -w @almost-formal/api && npm run build -w @almost-formal/web","db:generate":"node scripts/prisma-generate.mjs","db:migrate":"node scripts/prepare-db.mjs && prisma migrate deploy --schema apps/api/prisma/schema.prisma","db:seed":"tsx apps/api/prisma/seed.ts","db:seed:sql":"node scripts/seed-sql.mjs","dev":"npm run dev:web","dev:api":"npm run dev -w @almost-formal/api","dev:web":"node -r dotenv/config scripts/run-dev.mjs dev:web","lint":"eslint apps packages tests","smoke:d1":"npx tsx scripts/smoke-d1.mts","test":"node --import tsx --test tests/api-d1.test.ts","test:d1":"node --import tsx --test tests/api-d1.test.ts","test:e2e":"playwright test","typecheck":"tsc --noEmit -p apps/api && tsc --noEmit -p apps/web","worker:init:d1":"npx tsx scripts/worker-init-d1.ts"},"workspaces":["apps/*","packages/*"]}