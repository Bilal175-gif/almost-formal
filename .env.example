# Almost Formal — Cloudflare Worker API (Hono + D1 + Cloudinary)
# Local dev only. Real values live in Worker secrets / .dev.vars
# (both gitignored). NEVER commit real secrets. See CUTOVER.md.
#
# Local D1 (wrangler dev --local) needs no DATABASE_URL. The local
# SQLite DATABASE_URL below is only for the local admin:create
# tooling (apps/api/src/create-admin.ts) and local Prisma tooling.
DATABASE_URL="file:./dev.db"
PORT=4100
APP_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:4100
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dmwgexmef
CLOUDINARY_CLOUD_NAME=dmwgexmef
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_CACHE_TTL_SECONDS=30
NODE_ENV=development
# Set only when running npm run admin:create / admin:reset:d1.
# Never commit these values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email is Resend over HTTPS only (Workers have no SMTP).
# Leave empty to run without email: orders/contact still save.
RESEND_API_KEY=
EMAIL_FROM=
STORE_NOTIFICATION_EMAIL=

# Live Worker (production) — set in Cloudflare, not here:
#   wrangler d1: almost-formal-db (24bd6c7d-0cf3-408d-bd98-516d96018170)
#   wrangler secret put CLOUDINARY_API_KEY
#   wrangler secret put CLOUDINARY_API_SECRET
#   wrangler secret put RESEND_API_KEY   (optional)
#   [vars] in apps/api/wrangler.toml: APP_ORIGIN, EMAIL_FROM,
#   STORE_NOTIFICATION_EMAIL, PUBLIC_CACHE_TTL_SECONDS
#
# Frontend production build (see .github/workflows/cloudflare-production.yml):
#   API_URL / NEXT_PUBLIC_API_URL = GitHub var PRODUCTION_API_URL
#   (the live API Worker origin, e.g. https://almost-formal-api.<subdomain>.workers.dev)
#
# Render + Neon (OLD, kept live only as rollback until cutover is verified):
#   see docs/RENDER_FREE_SETUP.md and apps/api/src/express-legacy/
