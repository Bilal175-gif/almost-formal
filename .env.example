DATABASE_URL="file:./dev.db"
PORT=4100
APP_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:4100
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=
SMTP_FROM="Almost Formal <your-address@gmail.com>"
STORE_NOTIFICATION_EMAIL=your-address@gmail.com
NODE_ENV=development
# Set only when running npm run admin:create. Never commit these values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Hosted API: private Render environment; see docs/RENDER_FREE_SETUP.md.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
# APP_ORIGIN=https://your-frontend.workers.dev
# STORAGE_MODE=cloudinary
# TRUST_PROXY_HOPS=1
# PUBLIC_CACHE_TTL_SECONDS=30
# Render Free blocks SMTP ports. Optional HTTPS email:
RESEND_API_KEY=
EMAIL_FROM=
